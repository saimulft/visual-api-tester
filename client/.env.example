# Dialed settings. Copy this file to .env and fill in what you need.
# Nothing here is required to try Dialed locally: without DATABASE_URL it runs on SQLite.

# --- Database ---
# Unset or file:./path.db gives SQLite (default ./.data/dialed.db).
# postgres://user:pass@host:5432/db (or postgresql://) gives Postgres.
DATABASE_URL=
# Most Postgres connections the app keeps open (default 10).
DATABASE_POOL_MAX=

# --- App ---
# The address people open Dialed at. Links in emails use it, and cookies are Secure when it's https.
APP_URL=http://localhost:3300
# 32 random bytes (for example `openssl rand -base64 32`). Seals saved API and AI keys. Never change it once keys exist.
APP_SECRET=
# open (default) or closed. Closed shows a friendly message on the sign-up page.
SIGNUPS=open
# How many proxies sit in front of the app, so rate limits read the real client address (default 0).
TRUSTED_PROXY_HOPS=
# Shown as "Open source on GitHub" on the account pages.
NEXT_PUBLIC_REPO_URL=

# --- Email ---
# Without SMTP_HOST, each mail goes to the console and to ./.dev-mail/ instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# The From address, for example "Dialed <hello@example.com>".
MAIL_FROM=

# --- Seed ---
# The password both seed people get (npm run db:seed).
SEED_PASSWORD=

# --- Go-live only ---
# The hosted Postgres. Only the go-live step uses it; dev, tests and the seed never do.
LIVE_DATABASE_URL=

# --- End-to-end tests ---
# A real AI key and model for the E2E run (provider: anthropic, openai, gemini or openrouter).
E2E_AI_PROVIDER=
E2E_AI_MODEL=
E2E_AI_KEY=
# A CoreSignal key for the E2E run.
E2E_CORESIGNAL_KEY=

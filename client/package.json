{
  "name": "dialed",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-3300}",
    "build": "next build",
    "start": "npm run db:migrate && next start --port ${PORT:-3300}",
    "lint": "eslint && npm run lint:names",
    "lint:names": "ls-lint -workdir .. -config ../.ls-lint.yml",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:pg": "TEST_DB=postgres vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:pg": "node scripts/db-pg.mjs",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db-seed.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "better-sqlite3": "^13.2.0",
    "cmdk": "^1.1.1",
    "croner": "^11.0.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "kysely": "^0.29.9",
    "linkedom": "^0.18.15",
    "lucide-react": "^1.74.0",
    "maplibre-gl": "^6.18.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "turndown": "^7.2.5",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@ls-lint/ls-lint": "^2.3.2",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true
  }
}

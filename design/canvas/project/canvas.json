    "n1": { "x": 3980, "y": 0, "w": 420, "fill": "teal", "text": "Sign up is email and password only. The dark box plays once on load: a line from the API docs becomes a fader, then data, then Ready. Connect your AI shows both ways side by side; the MCP way needs no AI key." },
    "n2": { "x": 5970, "y": 1320, "w": 420, "fill": "teal", "text": "Project cards are whole-card links into the workspace (try Play). Setup plays from 12 of 18 controls to Ready to dial; Tweaks can freeze it on In progress or Done." },
    "n3": { "x": 3510, "y": 2640, "w": 420, "fill": "teal", "text": "Press Play on the workspace: drag the faders, flip the switches, switch Table, JSON and Request, then Run. Matches and credits update live because CoreSignal search is free; full records cost 20 credits each." },
    "n4": { "x": 5970, "y": 5140, "w": 420, "fill": "teal", "text": "Saved data: each dataset appends, replaces or keeps every run; export CSV, Excel or JSON, or copy a live CSV link for Google Sheets. Schedules show the next three runs and skip a run that would pass its credit cap." }
